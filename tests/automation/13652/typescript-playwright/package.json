{
  "name": "pacco-web-13652-playwright",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Playwright automation suite generated from tests/cases/13652-testcases.csv (JIRA 13652 - Pacco Login and Role-Aware Landing).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:static": "playwright test --project=static-analysis",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:a11y": "playwright test --project=a11y",
    "test:live": "playwright test --project=live-platform",
    "test:offline": "playwright test --project=static-analysis --project=api --project=ui --project=a11y",
    "a11y:scan": "ts-node --project tsconfig.json scripts/scan-and-report.ts",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "axe-core": "4.10.2",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.19.0"
  }
}
