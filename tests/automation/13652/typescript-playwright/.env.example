# ---------------------------------------------------------------------------
# Pacco.Web / JIRA 13652 - Playwright suite configuration.
#
# Copy to `.env` in this directory and adjust. `.env` is git-ignored.
#
# 🚫 NEVER commit a real credential here. Every value below is either a local
#    development address or a SYNTHETIC fixture transcribed verbatim from
#    tests/cases/13652-testcases.csv. The accounts named are example.com
#    fixtures that exist only in a locally seeded Docker Compose stack.
# ---------------------------------------------------------------------------

# --- Addresses under test --------------------------------------------------
# The Pacco.Web standalone browser client's own local origin.
PACCO_WEB_BASE_URL=http://localhost:5173
# The single local API Gateway. The browser client reaches the platform only
# through this address - no service port is ever contacted directly.
PACCO_GATEWAY_BASE_URL=http://localhost:5000
# The only backend path this capability calls.
PACCO_SIGN_IN_PATH=/identity/sign-in
# A representative gateway route that requires a bearer token (TC-083, TC-101).
PACCO_PROTECTED_ROUTE_PATH=/parcels
# An origin the gateway's allowed-origin list deliberately does NOT name (TC-046).
PACCO_DISALLOWED_ORIGIN_URL=http://localhost:4173

# --- Repository roots for the static-analysis rows -------------------------
# Root of the Pacco.Web client checkout. Defaults to this suite's repository.
PACCO_CLIENT_REPO_DIR=
# Directory holding ntrada.yml, ntrada.docker.yml, ntrada-async.yml and
# ntrada-async.docker.yml. Leave blank to auto-discover a sibling checkout.
PACCO_GATEWAY_CONFIG_DIR=
# Directory holding the Pacco Docker Compose definitions (infrastructure.yml,
# services.yml). Leave blank to auto-discover a sibling checkout.
PACCO_COMPOSE_DIR=
# Git revision the gateway configuration is compared against for TC-069.
PACCO_GATEWAY_BASELINE_REV=origin/main

# --- Synthetic test accounts (CSV "Test Data" column) ----------------------
# These are fixtures, not secrets. Seed them into the local stack through the
# platform's own sign-up path before running the @live project.
PACCO_USER_EMAIL=jane.smith@pacco.example.com
PACCO_USER_PASSWORD=Str0ng-Passphrase!2026
PACCO_ADMIN_EMAIL=alex.morgan@pacco.example.com
PACCO_ADMIN_PASSWORD=Str0ng-Passphrase!2026
PACCO_OTHER_EMAIL=sam.rivera@pacco.example.com
PACCO_UNKNOWN_EMAIL=definitely.not.registered@pacco.example.com
PACCO_UNKNOWN_EMAIL_STUBBED=no.such.person@pacco.example.com
PACCO_WRONG_PASSWORD=WrongPassphrase!2026
PACCO_WRONG_PASSWORD_LIVE=DefinitelyNotTheRightOne!2026
PACCO_ADMIN_SHAPED_EMAIL=admin@pacco.example.com

# --- Distinctive canaries used as search needles ---------------------------
# Not credentials - deliberately unique strings the suite sweeps for.
PACCO_PASSWORD_CANARY=PWD-CANARY-9b41d7ce
PACCO_REFRESH_TOKEN_CANARY=REFRESH-CANARY-3f9c21ae
PACCO_REASON_CANARY=MongoDB.Driver.MongoConnectionException at IdentityRepository.GetAsync line 42

# --- Timing (every wait in the suite is derived from these) ----------------
# Must equal window.__PACCO_CONFIG__.signInTimeoutMs in public/pacco-config.js.
PACCO_SIGN_IN_TIMEOUT_MS=15000
PACCO_ACTION_TIMEOUT_MS=10000
PACCO_EXPECT_TIMEOUT_MS=10000
PACCO_NAVIGATION_TIMEOUT_MS=30000
PACCO_TEST_TIMEOUT_MS=90000
# Delay a stubbed sign-in response is held for (TC-015, TC-017).
PACCO_SLOW_RESPONSE_DELAY_MS=2000
# Delay before a stubbed connection is refused (TC-016).
PACCO_ABORT_DELAY_MS=300
# Idle observation window for the "screen polls nothing" rows (TC-071, TC-082).
PACCO_IDLE_OBSERVATION_MS=3000

# --- Accessibility ---------------------------------------------------------
# Either name a level (a|aa|aaa) or give an explicit comma-separated tag list.
A11Y_WCAG_LEVEL=aa
A11Y_WCAG_TAGS=
A11Y_FAIL_ON_VIOLATIONS=true

# --- Runtime -------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# Set to true to let Playwright start the Vite dev server itself.
PACCO_START_WEB_SERVER=false
# Compose service name of the identity/sign-in container (TC-081).
PACCO_SIGNIN_SERVICE_NAME=identity-service
# Set to true only when TLS verification must be relaxed for a self-signed
# local certificate. Verification is ON by default and should stay on.
PACCO_IGNORE_HTTPS_ERRORS=false
